  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log npx -y node@22.13.1 node_modules/vinext/dist/cli.js dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log npx -y node@22.13.1 node_modules/vinext/dist/cli.js build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log npx -y node@22.13.1 node_modules/vinext/dist/cli.js start",
    "test:engine": "npx -y node@22.13.1 --import tsx --test tests/scheduling.test.ts",
    "test:plan-year": "npx -y node@22.13.1 --import tsx --test tests/plan-year.test.ts",
    "test:agent-route": "npx -y node@22.13.1 --import tsx --test tests/plan-agent-route.test.ts",
    "test:calendar-import": "npx -y node@22.13.1 --import tsx --test tests/calendar-import.test.ts",
    "test:rule-summaries": "npx -y node@22.13.1 --import tsx --test tests/rule-summaries.test.ts",
    "test:sharepoint-plan": "npx -y node@22.13.1 --import tsx --test tests/sharepoint-plan.test.ts",
    "test:outlook-sync": "npx -y node@22.13.1 --import tsx --test tests/outlook-sync.test.ts",
    "test": "npm run test:engine && npm run test:plan-year && npm run test:agent-route && npm run test:calendar-import && npm run test:rule-summaries && npm run test:sharepoint-plan && npm run test:outlook-sync && npm run build && npx -y node@22.13.1 --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "ical.js": "^2.2.1",
    "jspdf": "^3.0.4",
